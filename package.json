{
  "name": "bulwark-desktop",
  "productName": "Bulwark",
  "version": "0.1.0",
  "description": "Bulwark Mail for the desktop",
  "license": "AGPL-3.0-only",
  "author": "Bulwark Mail",
  "homepage": "https://bulwarkmail.org",
  "type": "module",
  "private": true,
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "fetch-webmail": "node scripts/fetch-webmail.mjs",
    "start": "node build.mjs && node scripts/run-electron.mjs .",
    "test": "node build.mjs && node scripts/build-native.mjs --optional && playwright test",
    "build:native": "node scripts/build-native.mjs",
    "pack:dir": "node build.mjs && node scripts/build-native.mjs --optional && electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
